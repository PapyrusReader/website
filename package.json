{
  "name": "papyrus-landing",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf build",
    "build:scss": "sass scss/style.scss build/css/style.css --style=compressed --no-source-map",
    "build:html": "cp index.html build/ && node scripts/stamp-version.js",
    "build:js": "esbuild js/main.js --bundle --minify --outfile=build/js/main.js",
    "build:assets": "cp -r public build/",
    "build": "npm run clean && mkdir -p build/css build/js build/public && npm run build:scss && npm run build:html && npm run build:js && npm run build:assets",
    "watch:scss": "sass scss/style.scss css/style.css --style=expanded --no-source-map --watch",
    "watch:js": "esbuild js/main.js --bundle --outfile=build/js/main.js --watch=forever",
    "dev": "concurrently -n scss,js,server -c magenta,cyan,green \"npm run watch:scss\" \"npm run watch:js\" \"serve -l 8090\""
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "esbuild": "^0.24.0",
    "sass": "^1.80.0"
  },
  "dependencies": {
    "serve": "^14.2.5"
  }
}