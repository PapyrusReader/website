{
  "name": "papyrus-landing",
  "version": "1.1.1",
  "private": true,
  "scripts": {
    "clean": "rm -rf build",
    "build:scss": "sass scss/style.scss build/css/style.css --style=compressed --no-source-map",
    "build:html": "cp index.html build/ && node scripts/stamp-version.js",
    "build:js": "esbuild js/theme.js js/main.js --minify --outdir=build/js",
    "build:assets": "cp -r public build/ && cp robots.txt sitemap.xml build/",
    "build": "npm run clean && mkdir -p build/css build/js build/public && npm run build:scss && npm run build:html && npm run build:js && npm run build:assets",
    "watch:scss": "sass scss/style.scss css/style.css --style=expanded --no-source-map --watch",
    "dev": "concurrently -n scss,server -c magenta,green \"npm run watch:scss\" \"serve -l 8090\"",
    "test": "node --test js/tests/*.test.cjs"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "esbuild": "^0.24.0",
    "sass": "^1.80.0"
  },
  "dependencies": {
    "serve": "^14.2.5"
  }
}
